# Backend Environment Variables
PORT=5000
NODE_ENV=development
TRUST_PROXY_HOPS=0

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/resumeai?retryWrites=true&w=majority

# First-party authentication (generate a random secret with at least 32 bytes)
AUTH_ACCESS_TOKEN_SECRET=
AUTH_TOKEN_ISSUER=resumeai4u-api
AUTH_TOKEN_AUDIENCE=resumeai4u-web
AUTH_COOKIE_SAME_SITE=lax
# Optional when frontend and API are on sibling subdomains of the same site.
# AUTH_COOKIE_DOMAIN=.example.com

# Email verification and password recovery (SMTP required to enable these flows)
APP_ORIGIN=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Groq AI API
GROQ_API_KEY=gsk_your_groq_api_key

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
